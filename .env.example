# NODE_ENV=production   (set on the live server; this also disables DEV_PRO)
# Copy to .env and fill in
ANTHROPIC_API_KEY=            # optional for now (Explain, Translate, Accurate mode)
MODEL=claude-haiku-4-5-20251001
PAYSTACK_SECRET_KEY=sk_test_...   # Paystack dashboard > Settings > API Keys
PRO_PRICE_NGN=1500                # 30 days Pro for Nigerians, in Naira
PRO_PRICE_USD=2                   # 30 days Pro for foreign clients, in US dollars
USD_ENABLED=0                     # set to 1 ONLY after Paystack approves USD on your account                # price of 30 days Pro, in Naira
GA_ID=G-XXXXXXXXXX                # Google Analytics 4 Measurement ID
WHATSAPP_NUMBER=2348012345678      # your WhatsApp in international format, no + or spaces
ADMIN_KEY=choose-a-long-private-key  # protects /admin (code generator)
SECRET=put-a-long-random-string-here
BASE_URL=http://localhost:3000    # your live https domain after hosting
FREE_DAILY=5
ACCURATE_FREE_DAILY=3
PORT=3000
# TEST MODE: 1 = tap the plan badge to switch Free/Pro without paying. REMOVE before going live.
DEV_PRO=1
